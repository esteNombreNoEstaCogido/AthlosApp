rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function hasNoClientManagedCredentials(data) {
      return !data.keys().hasAny(['password', 'admin', 'role', 'isAdmin']);
    }

    match /athlos_clients/{username} {
      allow get: if isAdmin() || (signedIn() && resource.data.authUid == request.auth.uid);
      allow list: if isAdmin();

      allow create: if isAdmin() || (
        signedIn()
        && request.resource.data.authUid == request.auth.uid
        && request.resource.data.username == username
        && request.auth.token.email == username + '@athlos.app'
        && hasNoClientManagedCredentials(request.resource.data)
      );

      allow update: if isAdmin() || (
        signedIn()
        && resource.data.authUid == request.auth.uid
        && request.resource.data.authUid == resource.data.authUid
        && request.resource.data.username == resource.data.username
        && hasNoClientManagedCredentials(request.resource.data)
      );

      allow delete: if isAdmin();
    }

    match /athlos_public/{documentId} {
      allow get: if signedIn() && documentId == 'config';
      allow list: if false;
      allow create, update, delete: if isAdmin();
    }

    match /athlos_admin_followups/{username} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
